# Normalize line endings to LF everywhere.
# Windows users editing in VS Code/etc. won't notice; CI on Linux stays happy.

* text=auto eol=lf

# Explicit text files
*.cs            text eol=lf
*.csproj        text eol=lf
*.sln           text eol=lf -crlf -diff merge=union
*.props         text eol=lf
*.py            text eol=lf
*.pyi           text eol=lf
*.md            text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.ps1           text eol=lf
*.psm1          text eol=lf
*.sh            text eol=lf
*.cfg           text eol=lf

# Binary
*.dll           binary
*.pdb           binary
*.png           binary
*.jpg           binary
*.gif           binary
*.ico           binary
*.zip           binary
*.snk           binary
