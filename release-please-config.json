{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bootstrap-sha": "0000000000000000000000000000000000000000",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "worldbox-mcp",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "server/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "xml",
          "path": "mod/src/WorldBoxBridge/WorldBoxBridge.csproj",
          "xpath": "//Project/PropertyGroup/Version"
        },
        {
          "type": "generic",
          "path": "mod/src/WorldBoxBridge/PluginInfo.cs"
        },
        {
          "type": "generic",
          "path": "server/src/worldbox_mcp/__init__.py"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "sentence-case"
    }
  ],
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "refactor", "section": "Refactors" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ]
}
