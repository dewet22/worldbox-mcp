<Project>

  <PropertyGroup>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <NoWarn></NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>WorldBoxBridge</RootNamespace>
    <Company>fullya99</Company>
    <Authors>fullya99 and contributors</Authors>
    <Product>WorldBoxBridge</Product>
    <Copyright>Copyright (c) 2026 fullya99</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fullya99/worldbox-mcp</RepositoryUrl>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Emit packages.lock.json so the locked-mode restore that ci.yml and release.yml already run
      actually pins content hashes. Without a lock file that flag silently succeeds and verifies
      nothing, which matters now that UnityEngine refs come from a third-party feed and the
      release build runs in a job that holds the PyPI id-token.
      Regenerate after a deliberate version change with a force-evaluate restore.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyOriginatorKeyFile></AssemblyOriginatorKeyFile>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <!-- UnityEngine references come from the UnityEngine.Modules NuGet package (see
       Directory.Packages.props); no local WorldBox install is needed to build. -->

</Project>
