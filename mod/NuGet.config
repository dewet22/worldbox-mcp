<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      BepInEx publishes some packages on their own feed (BepInEx.PluginInfoProps etc.).
      Kept here so dotnet restore works on machines without a global NuGet config.
    -->
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bepinex">
      <package pattern="BepInEx.*" />
      <!--
        Unity reference assemblies per engine version (nuget.org's copy stops at 2021.3).
        Mapped by exact id, not `UnityEngine.*`: a wildcard would extend trust for the whole
        UnityEngine namespace to this feed, and only this one package is actually consumed.
      -->
      <package pattern="UnityEngine.Modules" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
