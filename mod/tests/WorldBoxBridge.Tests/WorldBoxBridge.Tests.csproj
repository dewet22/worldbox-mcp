<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The test project intentionally does NOT reference the mod project, so it stays buildable
         on machines (and CI runners) that don't have a WorldBox install. It tests pure-logic
         classes by linking their source files directly. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <!-- Linked sources: only files that have zero dependencies on Unity / BepInEx / Newtonsoft. -->
  <ItemGroup>
    <Compile Include="..\..\src\WorldBoxBridge\AssetSuggester.cs" Link="Linked\AssetSuggester.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Http\ErrorCode.cs" Link="Linked\Http\ErrorCode.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\CommandCategory.cs" Link="Linked\Commands\CommandCategory.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\TurnGate.cs" Link="Linked\Commands\TurnGate.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Reflection\IGameUiAccess.cs" Link="Linked\Reflection\IGameUiAccess.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Control\WindowDismissal.cs" Link="Linked\Commands\Control\WindowDismissal.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Read\UiStateReport.cs" Link="Linked\Commands\Read\UiStateReport.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Action\BridgeRejectionException.cs" Link="Linked\Commands\Action\BridgeRejectionException.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Action\ActionPermissions.cs" Link="Linked\Commands\Action\ActionPermissions.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Action\PowerDelegateSelector.cs" Link="Linked\Commands\Action\PowerDelegateSelector.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Action\PulsePath.cs" Link="Linked\Commands\Action\PulsePath.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Action\PowerDelegateFields.cs" Link="Linked\Commands\Action\PowerDelegateFields.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Read\ScreenshotScaler.cs" Link="Linked\Commands\Read\ScreenshotScaler.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Control\SavePathResolver.cs" Link="Linked\Commands\Control\SavePathResolver.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Control\SaveFileReader.cs" Link="Linked\Commands\Control\SaveFileReader.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Commands\Control\GameSavePaths.cs" Link="Linked\Commands\Control\GameSavePaths.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Session\AgentRole.cs" Link="Linked\Session\AgentRole.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Session\Permission.cs" Link="Linked\Session\Permission.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Session\Agent.cs" Link="Linked\Session\Agent.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Session\AgentRegistry.cs" Link="Linked\Session\AgentRegistry.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Session\RequestContext.cs" Link="Linked\Session\RequestContext.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Session\Session.cs" Link="Linked\Session\Session.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Session\TurnOrder.cs" Link="Linked\Session\TurnOrder.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Session\MessageBus.cs" Link="Linked\Session\MessageBus.cs" />
    <Compile Include="..\..\src\WorldBoxBridge\Session\Objective.cs" Link="Linked\Session\Objective.cs" />
  </ItemGroup>

</Project>
